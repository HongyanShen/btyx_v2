<navigator wx:if="{{signedIn}}" class="creative-work-entry" url="/subpackages/task/creative/index?mine=1">我的创作任务 ›</navigator>
<import src="/templates/loading.wxml" />
<view class="work-page">
  <view wx:if="{{!signedIn && !loading}}" class="work-empty">
    <image src="/assets/ai.png" mode="aspectFit" />
    <view>登录后查看任务进度</view>
    <view class="work-pill work-empty-button" aria-role="button" bindtap="openLogin">登录</view>
  </view>
  <block wx:else>
    <view wx:if="{{signedIn && showSubscription}}" class="work-notice work-subscribe" aria-role="button" bindtap="subscribe">
      <text class="grow">🔔 开启通知，审核结果第一时间告诉你</text><text>›</text>
    </view>
    <view wx:if="{{!loading && !error && showPlayback}}" class="work-notice {{pendingTasks ? 'work-notice-pending' : ''}}" aria-role="button" bindtap="openPlayback">
      <text class="grow">📊 {{playbackMessage}}</text><text class="work-notice-action">交播放数据 ›</text>
    </view>

    <scroll-view scroll-x class="work-tabs" aria-label="任务状态筛选">
      <view class="work-tabs-inner">
        <view wx:for="{{tabs}}" wx:key="value" class="work-tab {{selected === item.value ? 'work-tab-active' : ''}}" data-value="{{item.value}}" aria-role="button" bindtap="select">
          {{item.value ? item.label + ' ' + item.count : item.label}}
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{error}}" class="error">
      <view>{{error}}</view>
      <view class="work-pill work-empty-button" aria-role="button" bindtap="load">重试</view>
    </view>
    <template wx:elif="{{loading}}" is="loading-card" />
    <view wx:if="{{!loading && !error && !tasks.length}}" class="work-empty">
      <image src="/assets/ai.png" mode="aspectFit" />
      <view>还没有任务</view>
      <view class="work-pill work-empty-button" aria-role="button" bindtap="goHome">去首页领一个</view>
    </view>

    <block wx:if="{{!loading && !error}}">
      <view wx:for="{{tasks}}" wx:key="id" class="work-card" data-id="{{item.id}}" bindtap="open">
        <view class="work-card-header">
          <view class="work-icon"><image src="/assets/marketing-white.png" mode="aspectFit" /></view>
          <view class="grow">
            <view class="work-card-title">
              {{item.title}} <text wx:if="{{item.sourceLabel}}" class="work-badge {{item.reissued ? 'work-source-reissued' : 'work-source-assigned'}}">{{item.sourceLabel}}</text>
            </view>
            <view class="work-meta">
              营销分发 · {{item.platformText}}
              <text wx:if="{{item.deadline}}"> · 截止 {{item.deadline.time}} · 还剩 <text class="work-countdown">{{item.deadline.remaining}}</text></text>
              <text wx:elif="{{item.dueDate}}"> · 截止 {{item.dueDate}}</text>
            </view>
          </view>
          <text class="work-badge work-badge-{{item.tone}}">{{item.statusLabel}}</text>
        </view>
        <view class="work-card-footer">
          <text class="grow">{{item.footer}}</text>
          <view class="work-pill {{item.quietAction ? 'work-pill-quiet' : ''}}" aria-role="button" data-id="{{item.id}}" catchtap="open">{{item.action}}</view>
        </view>
      </view>
    </block>
  </block>
</view>
