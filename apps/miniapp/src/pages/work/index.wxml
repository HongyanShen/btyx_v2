<view class="page work-page">
  <view wx:if="{{!signedIn && !loading}}" class="card">
    <view class="muted">登录后查看任务进度</view>
    <button class="primary spaced" bindtap="openLogin">登录</button>
  </view>
  <block wx:else>
    <button wx:if="{{!loading && !error}}" class="notice data-entry" bindtap="showScreenshots">
      <view class="grow">
        <view class="data-entry-title">交播放数据</view>
        <view>{{screenshotCount ? screenshotCount + ' 条任务待补截图' : '每周一 12:00 前提交上周播放截图'}}</view>
      </view>
      <text>{{needsScreenshots ? '查看全部' : '去查看'}} ›</text>
    </button>

    <scroll-view scroll-x class="work-tabs">
      <button wx:for="{{tabs}}" wx:key="value" class="work-tab {{!needsScreenshots && selected === item.value ? 'work-tab-active' : ''}}" data-value="{{item.value}}" bindtap="select">
        {{item.label}}
      </button>
    </scroll-view>

    <view wx:if="{{error}}" class="error">
      <view>{{error}}</view>
      <button class="secondary-button small-button spaced" bindtap="load">重试</button>
    </view>
    <view wx:elif="{{loading}}" class="empty">正在加载任务…</view>
    <view wx:elif="{{!tasks.length}}" class="empty">{{needsScreenshots ? '暂无待补截图的任务' : '暂无此类任务'}}</view>

    <block wx:if="{{!error && !loading}}">
      <view wx:for="{{tasks}}" wx:key="id" class="card work-card" data-id="{{item.id}}" bindtap="open">
        <view class="work-card-header">
          <view class="work-icon">
            <image src="/assets/marketing-white.png" mode="aspectFit" />
          </view>
          <view class="grow">
            <view class="card-title">{{item.title}}</view>
            <view class="muted">营销分发 · {{item.platformText}}</view>
          </view>
          <text class="badge">{{item.statusLabel}}</text>
        </view>
        <text wx:if="{{item.showSource}}" class="badge {{item.reissued ? 'badge-reissued' : ''}}">{{item.sourceLabel}}</text>
        <view wx:if="{{item.notice}}" class="work-rejection">{{item.notice}}</view>
        <view class="work-card-footer">
          <view class="grow muted">
            <view wx:if="{{item.deadline}}">{{item.deadline.time}} 前交链接 · {{item.deadline.remaining}}</view>
            <view wx:else>{{item.progressHint}}</view>
          </view>
          <text class="work-arrow">›</text>
        </view>
      </view>
    </block>
  </block>
</view>
