@import "../../styles/wallet.wxss";

.wallet-hero {
  padding: 12rpx 36rpx 100rpx;
  border-radius: 0 0 52rpx 52rpx;
  background: linear-gradient(180deg, #7d74a9 0%, #8b82be 60%, #d4a8c0 100%);
  color: #fff;
}

.wallet-hero-label {
  font-size: 25rpx;
}
.wallet-total {
  margin: 4rpx 0 20rpx;
  font-size: 64rpx;
}
.wallet-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  font-size: 22rpx;
}
.wallet-stats .wallet-number {
  display: block;
  font-size: 34rpx;
}
.wallet-content {
  position: relative;
  margin: -68rpx 28rpx 0;
  padding-bottom: 36rpx;
}

.wallet-note {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e4def0;
  border-radius: 24rpx;
  background: #fff;
  color: #554a7d;
  box-shadow: 0 12rpx 40rpx #2d265413;
  font-size: 26rpx;
  line-height: 1.55;
}

.wallet-inline {
  display: inline-block;
  width: auto !important;
  margin: 0 0 0 8rpx !important;
  padding: 0 8rpx;
  background: transparent;
  color: #655a98;
  font-size: inherit;
  font-weight: 700;
  line-height: inherit;
}
.wallet-balance {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
}
.wallet-balance-label {
  color: #6e638e;
  font-size: 25rpx;
}
.wallet-balance-value {
  margin: 2rpx 0;
  font-size: 48rpx;
}
.wallet-withdraw {
  flex: none;
  width: 132rpx !important;
  height: 76rpx;
  margin: 0 !important;
  padding: 0;
}
.wallet-empty {
  padding: 52rpx 28rpx;
  text-align: center;
}
.wallet-empty-title {
  margin-bottom: 12rpx;
  font-weight: 750;
}
.wallet-small {
  display: inline-flex;
  width: auto !important;
  min-height: 62rpx;
  margin: 22rpx auto 0;
  padding: 0 28rpx;
  font-size: 26rpx;
}
.wallet-sources {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.wallet-source {
  display: flex;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  min-height: 120rpx;
  gap: 2rpx;
  padding: 18rpx 14rpx;
  border-radius: 28rpx;
  background: #fff;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: left;
}
.wallet-points {
  width: 100% !important;
  margin: 0 !important;
}
.wallet-source-value {
  font-size: 28rpx;
}
.wallet-future {
  color: #817797;
}
.wallet-row {
  display: flex;
  width: 100% !important;
  align-items: center;
  gap: 18rpx;
  min-height: 88rpx;
  margin: 0 0 16rpx !important;
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #2d2654;
  line-height: 1.4;
  text-align: left;
}
.wallet-row image {
  width: 40rpx;
  height: 40rpx;
  flex: none;
}
.wallet-chevron {
  color: #817797;
  font-size: 30rpx;
}
