.offer-page {
  padding: 24rpx 28rpx calc(160rpx + env(safe-area-inset-bottom));
}

.offer-summary,
.offer-section {
  background: #fff;
  border-radius: 32rpx;
}

.offer-summary {
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 4rpx #2d26540a;
}

.offer-heading {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.offer-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  overflow: hidden;
  border-radius: 50%;
  background: linear-gradient(135deg, #b5acd6, #7b72aa);
}

.offer-icon-image {
  width: 48rpx;
  height: 48rpx;
}

.offer-heading-text {
  flex: 1;
  min-width: 0;
}

.offer-title {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.offer-tag {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #2d2654;
  color: #fff;
  font-size: 22rpx;
  line-height: 1.4;
}

.offer-stats {
  display: flex;
  flex: none;
  gap: 24rpx;
  max-width: 46%;
  color: #6b6494;
  font-size: 21rpx;
  line-height: 1.4;
}

.offer-stats > view:first-child {
  min-width: 0;
}

.offer-stats > view:last-child {
  flex: none;
}

.offer-stat-value {
  display: block;
  margin-top: 4rpx;
  color: #2d2654;
  font-size: 30rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}

.offer-description {
  margin: 24rpx 0 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #f6f5fa;
  color: #6b6494;
  font-size: 24rpx;
  line-height: 1.6;
}

.offer-section {
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
  color: #3b3568;
  font-size: 26rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.offer-section-title {
  margin-bottom: 16rpx;
  color: #2d2654;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
}

.offer-subheading,
.offer-strong {
  color: #2d2654;
  font-weight: 700;
}

.offer-subheading-spaced {
  margin-top: 16rpx;
}

.offer-bullet {
  position: relative;
  margin: 4rpx 0;
  padding-left: 36rpx;
}

.offer-bullet::before {
  content: "";
  position: absolute;
  top: 18rpx;
  left: 2rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #9d97b8;
}

.offer-stages {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.offer-stage {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx 8rpx 8rpx;
  border-radius: 28rpx;
  background: #f6f5fa;
  font-size: 24rpx;
  line-height: 1.2;
}

.offer-stage-number,
.offer-check-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  font-size: 22rpx;
}

.offer-stage-number {
  background: linear-gradient(135deg, #8b82be, #7b72aa);
  color: #fff;
}

.offer-data-note {
  margin-top: 16rpx;
  color: #6b6494;
  font-size: 24rpx;
  line-height: 1.55;
}

.offer-check {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}

.offer-check-mark {
  background: #fff6db;
  color: #925c00;
  font-weight: 800;
}

.offer-check-passed {
  background: #e6f7ec;
  color: #1e8648;
}

.offer-copyright {
  color: #6b6494;
  font-size: 23rpx;
  line-height: 1.5;
}

.offer-feedback {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fff0f0;
  color: #993e48;
  font-size: 26rpx;
}

.offer-footer {
  position: fixed;
  z-index: 1;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 28rpx calc(26rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e2dff0;
  background: #fff;
}

.offer-footer-rate {
  max-width: 36%;
  color: #6b6494;
  font-size: 22rpx;
  line-height: 1.35;
}

.offer-footer-price {
  display: block;
  color: #7b72aa;
  font-size: 36rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}

button.offer-button {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #fff;
  background: linear-gradient(135deg, #8b82be, #7b72aa);
}

button.offer-button[disabled] {
  color: #6b6494;
  background: #f0edf8;
}

button.offer-button-pressed {
  background: linear-gradient(135deg, #7b72aa, #3b3568);
}

.creative-tabs{display:flex;gap:12rpx;margin:20rpx 0;background:#fff;padding:8rpx;border-radius:22rpx}.creative-tabs text,.creative-tabs navigator{flex:1;text-align:center;padding:12rpx}.creative-tabs .active{background:#40345f;border-radius:16rpx;color:white}
