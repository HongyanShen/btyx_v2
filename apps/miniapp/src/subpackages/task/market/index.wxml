<view class="market"><view class="hero"><text>营销分发</text><text>抖音 + 小红书</text></view><view wx:if="{{loading}}">正在加载…</view><view wx:elif="{{error}}">{{error}}<button bindtap="load">重试</button></view><block wx:else>
<view wx:if="{{creativeOnline}}" class="tabs"><text>分发任务</text><navigator url="/subpackages/task/creative/index">创作任务</navigator></view>
<view class="card"><text class="title">今日营销分发</text><view>每个平台 {{price?'¥'+price:'—'}}　每天 {{dailyLimit}} 条</view><view>按任务要求使用素材发布，并提交作品链接。</view><view wx:if="{{today}}">今天已领 {{used}} / {{dailyLimit}} 条</view><navigator wx:if="{{today}}" url="/subpackages/task/detail/index?id={{today.id}}">继续已领任务 ›</navigator><navigator wx:if="{{!today || used < dailyLimit}}" class="action" url="/subpackages/task/today/index">{{today && hasContent?'再领一条':'查看任务'}}</navigator><text wx:else>今天 {{dailyLimit}} 条已领满</text></view></block></view>