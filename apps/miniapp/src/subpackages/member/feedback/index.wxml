<view class="page">
  <view class="title">意见反馈</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="card">
    <textarea class="input" value="{{body}}" maxlength="2000" placeholder="请描述遇到的问题或建议" bindinput="change" />
    <button class="primary spaced" disabled="{{submitting || !body}}" loading="{{submitting}}" bindtap="submit">提交反馈</button>
  </view>
  <view class="section-title">历史反馈</view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{!items.length}}" class="empty">还没有反馈记录</view>
  <view wx:for="{{items}}" wx:key="id" class="card">
    <view class="requirements">{{item.body}}</view>
    <view class="muted">{{item.time}}</view>
    <view wx:if="{{item.reply}}" class="notice spaced">工作人员回复：{{item.reply}}</view>
    <view wx:else class="badge">等待回复</view>
  </view>
</view>
