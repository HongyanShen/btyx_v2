<import src="/templates/loading.wxml" />
<view class="page">
  <view class="title">消息中心</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <template wx:if="{{loading}}" is="loading-card" />
  <view wx:elif="{{!items.length}}" class="empty">暂无消息。审核与结算进度会在这里通知。</view>
  <view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="read">
    <view class="row"><text class="card-title">{{item.title}}</text><text wx:if="{{!item.read}}" class="badge">未读</text></view>
    <view class="requirements">{{item.body}}</view>
    <view class="muted">{{item.time}}</view>
  </view>
</view>
