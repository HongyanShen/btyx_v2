@import "../../../styles/wallet.wxss";

.earnings-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: #ededf0;
}
.earnings-tab {
  flex: 1;
  width: 0 !important;
  min-height: 60rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  background: transparent;
  color: #666;
  font-size: 26rpx;
  line-height: 1.5;
}
.earnings-selected {
  background: #fff;
  color: #655a98;
  font-weight: 700;
}
.earnings-empty {
  padding: 8rpx;
}
.earnings-credit {
  color: #24824c;
}
