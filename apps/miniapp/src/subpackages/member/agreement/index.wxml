<import src="/templates/loading.wxml" />
<import src="./body.wxml" />
<view class="page">
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <template wx:if="{{loading}}" is="loading-card" />
  <view wx:elif="{{agreement}}" class="card">
    <view class="title">{{agreement.title}}</view>
    <template is="agreement-body" data="{{agreement: agreement}}" />
  </view>
  <view wx:elif="{{!error}}" class="empty">暂无协议</view>
  <view wx:if="{{agreement && consented}}" class="notice">你已确认当前版本协议。</view>
  <block wx:elif="{{agreement}}">
    <checkbox-group bindchange="toggle"><label><checkbox value="agree" checked="{{checked}}" color="#7b72aa" />我已阅读并同意以上合作协议</label></checkbox-group>
    <button class="primary spaced" loading="{{submitting}}" disabled="{{!checked || submitting}}" bindtap="confirm">确认合作协议</button>
  </block>
</view>
