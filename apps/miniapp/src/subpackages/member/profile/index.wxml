<view class="page profile-page">
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="empty">正在加载个人信息…</view>
  <button wx:elif="{{!signedIn}}" class="primary" bindtap="openLogin">登录</button>
  <button wx:elif="{{!user}}" class="secondary-button" bindtap="load">重试</button>
  <form wx:else bindsubmit="save">
    <view class="profile-fields">
      <view class="profile-field">
        <text class="profile-label">头像</text>
        <view class="profile-value">
          <button class="profile-choice" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{saving}}">
            <view class="member-avatar profile-avatar">
              <image wx:if="{{avatar}}" class="member-avatar-image" src="{{avatar}}" mode="aspectFill" />
              <text wx:else>兔</text>
            </view>
            <text>用微信头像</text>
            <text class="profile-chevron">›</text>
          </button>
        </view>
      </view>
      <view class="profile-field">
        <text class="profile-label">昵称</text>
        <view class="profile-value">
          <input class="profile-nickname" type="nickname" name="nickname" value="{{user.nickname}}" placeholder="填写或选用微信昵称" maxlength="32" disabled="{{saving}}" />
        </view>
      </view>
      <view class="profile-field">
        <text class="profile-label">手机号</text>
        <view class="profile-value">
          <text class="profile-phone">{{user.verified_phone || '未验证手机号'}}</text>
          <button class="profile-choice" open-type="getPhoneNumber" bindgetphonenumber="getPhone" loading="{{verifying}}" disabled="{{verifying || saving}}">
            <text>{{user.verified_phone ? '更换' : '获取微信手机号'}}</text>
            <text class="profile-chevron">›</text>
          </button>
        </view>
      </view>
    </view>
    <button class="primary" form-type="submit" loading="{{saving}}" disabled="{{saving || verifying}}">保存</button>
  </form>
</view>
